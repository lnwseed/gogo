#!/bin/bash
# ============================================================
#  LAMP Stack Setup สำหรับ CodeIgniter 3
#  - Apache2 + PHP 5.6 + MySQL + phpMyAdmin
#  - รองรับ .htaccess (mod_rewrite)
#  - Cloudflare Tunnel ready
#  รองรับ: Ubuntu 18.04/20.04 | Debian 10/11
# ============================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()    { echo -e "${GREEN}[✔]${NC} $1"; }
warn()   { echo -e "${YELLOW}[!]${NC} $1"; }
info()   { echo -e "${CYAN}[→]${NC} $1"; }
error()  { echo -e "${RED}[✘]${NC} $1"; exit 1; }

# ── ตรวจสิทธิ์ root ──────────────────────────────────────────
if [ "$EUID" -ne 0 ]; then
  error "กรุณารันด้วย sudo หรือ root: sudo bash $0"
fi

# ── กำหนดค่าตั้งต้น ─────────────────────────────────────────
DB_ROOT_PASS="${DB_ROOT_PASS:-$(openssl rand -base64 16)}"
PMA_PASS="${PMA_PASS:-$(openssl rand -base64 12)}"
WEB_ROOT="/var/www/html"
APACHE_CONF="/etc/apache2/sites-available/codeigniter.conf"

echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║     LAMP + CodeIgniter 3 Auto-Install Script     ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════╝${NC}"
echo ""

# ── 1. อัปเดต Package ────────────────────────────────────────
info "อัปเดต package list..."
apt-get update -qq
apt-get install -y -qq software-properties-common curl wget gnupg2 lsb-release ca-certificates apt-transport-https

# ── 2. เพิ่ม ondrej/php PPA (PHP 5.6) ────────────────────────
info "เพิ่ม PHP 5.6 repository (ondrej/php)..."
OS_ID=$(lsb_release -is | tr '[:upper:]' '[:lower:]')

if [ "$OS_ID" = "ubuntu" ]; then
  add-apt-repository -y ppa:ondrej/php
elif [ "$OS_ID" = "debian" ]; then
  curl -sSL https://packages.sury.org/php/apt.gpg | gpg --dearmor -o /usr/share/keyrings/sury-php.gpg
  echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" \
    > /etc/apt/sources.list.d/sury-php.list
fi

apt-get update -qq
log "เพิ่ม repository PHP 5.6 สำเร็จ"

# ── 3. ติดตั้ง Apache2 ───────────────────────────────────────
info "ติดตั้ง Apache2..."
apt-get install -y -qq apache2
a2enmod rewrite headers expires deflate
log "ติดตั้ง Apache2 + mod_rewrite สำเร็จ"

# ── 4. ติดตั้ง PHP 5.6 ───────────────────────────────────────
info "ติดตั้ง PHP 5.6 และ extensions ที่จำเป็น..."
apt-get install -y -qq \
  php5.6 \
  php5.6-cli \
  php5.6-common \
  php5.6-mysql \
  php5.6-curl \
  php5.6-gd \
  php5.6-mbstring \
  php5.6-xml \
  php5.6-zip \
  php5.6-json \
  php5.6-bcmath \
  libapache2-mod-php5.6

update-alternatives --set php /usr/bin/php5.6
log "ติดตั้ง PHP 5.6 สำเร็จ"

# ── 5. ติดตั้ง MySQL ─────────────────────────────────────────
info "ติดตั้ง MySQL Server..."
debconf-set-selections <<< "mysql-server mysql-server/root_password password ${DB_ROOT_PASS}"
debconf-set-selections <<< "mysql-server mysql-server/root_password_again password ${DB_ROOT_PASS}"
apt-get install -y -qq mysql-server mysql-client

# รักษาความปลอดภัยเบื้องต้น
mysql -u root -p"${DB_ROOT_PASS}" <<SQL 2>/dev/null || \
mysql -u root <<SQL
ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY '${DB_ROOT_PASS}';
DELETE FROM mysql.user WHERE User='';
DELETE FROM mysql.user WHERE User='root' AND Host NOT IN ('localhost','127.0.0.1','::1');
DROP DATABASE IF EXISTS test;
DELETE FROM mysql.db WHERE Db='test' OR Db='test\\_%';
FLUSH PRIVILEGES;
SQL

log "ติดตั้ง MySQL สำเร็จ"

# ── 6. ติดตั้ง phpMyAdmin ─────────────────────────────────────
info "ติดตั้ง phpMyAdmin..."
debconf-set-selections <<< "phpmyadmin phpmyadmin/dbconfig-install boolean true"
debconf-set-selections <<< "phpmyadmin phpmyadmin/app-password-confirm password ${PMA_PASS}"
debconf-set-selections <<< "phpmyadmin phpmyadmin/mysql/admin-pass password ${DB_ROOT_PASS}"
debconf-set-selections <<< "phpmyadmin phpmyadmin/mysql/app-pass password ${PMA_PASS}"
debconf-set-selections <<< "phpmyadmin phpmyadmin/reconfigure-webserver multiselect apache2"

apt-get install -y -qq phpmyadmin php-mbstring php-gettext

# Link phpMyAdmin ไป webroot
if [ ! -L /var/www/html/phpmyadmin ]; then
  ln -s /usr/share/phpmyadmin /var/www/html/phpmyadmin
fi

phpenmod mbstring
log "ติดตั้ง phpMyAdmin สำเร็จ"

# ── 7. ตั้งค่า Apache VirtualHost ────────────────────────────
info "สร้าง Apache VirtualHost สำหรับ CodeIgniter 3..."

cat > "$APACHE_CONF" <<'APACHECONF'
<VirtualHost *:80>
    ServerAdmin webmaster@localhost
    DocumentRoot /var/www/html

    # ─── รองรับ .htaccess ───────────────────────────────────
    <Directory /var/www/html>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # ─── phpMyAdmin ─────────────────────────────────────────
    <Directory /usr/share/phpmyadmin>
        Options SymLinksIfOwnerMatch
        DirectoryIndex index.php
        AllowOverride All
        Require all granted
    </Directory>

    # ─── Log ────────────────────────────────────────────────
    ErrorLog  ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined

    # ─── Cloudflare: เชื่อถือ IP จาก CF Tunnel ─────────────
    RemoteIPHeader CF-Connecting-IP
    RemoteIPHeader X-Forwarded-For
</VirtualHost>
APACHECONF

a2enmod remoteip
a2ensite codeigniter
a2dissite 000-default 2>/dev/null || true
log "สร้าง VirtualHost สำเร็จ"

# ── 8. สร้าง .htaccess สำหรับ CodeIgniter 3 ─────────────────
info "สร้าง .htaccess สำหรับ CodeIgniter 3..."

cat > "$WEB_ROOT/.htaccess" <<'HTACCESS'
# CodeIgniter 3 - Remove index.php from URL
Options -Indexes

RewriteEngine On
RewriteBase /

# Bypass สำหรับไฟล์จริงและโฟลเดอร์จริง
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ลบ index.php ออกจาก URL
RewriteRule ^index\.php$ - [L]
RewriteRule ^(.*)$ index.php/$1 [L]

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ปิดกั้นการเข้าถึงไฟล์ config
<FilesMatch "\.(env|log|sh|sql|git)$">
    Require all denied
</FilesMatch>
HTACCESS

log "สร้าง .htaccess สำเร็จ"

# ── 9. ตั้งค่า PHP 5.6 ───────────────────────────────────────
info "ปรับแต่ง PHP 5.6 configuration..."
PHP_INI="/etc/php/5.6/apache2/php.ini"

sed -i 's/^upload_max_filesize.*/upload_max_filesize = 64M/'    "$PHP_INI"
sed -i 's/^post_max_size.*/post_max_size = 64M/'                "$PHP_INI"
sed -i 's/^max_execution_time.*/max_execution_time = 300/'      "$PHP_INI"
sed -i 's/^memory_limit.*/memory_limit = 256M/'                 "$PHP_INI"
sed -i 's/^;date.timezone.*/date.timezone = Asia\/Bangkok/'     "$PHP_INI"
sed -i 's/^display_errors.*/display_errors = Off/'              "$PHP_INI"

log "ปรับแต่ง PHP.ini สำเร็จ"

# ── 10. ตั้งค่า permission ───────────────────────────────────
info "ตั้งค่า permission สำหรับ web root..."
chown -R www-data:www-data "$WEB_ROOT"
chmod -R 755 "$WEB_ROOT"
log "ตั้งค่า permission สำเร็จ"

# ── 11. Restart Services ─────────────────────────────────────
info "Restart Apache2 และ MySQL..."
systemctl restart apache2
systemctl restart mysql
systemctl enable apache2
systemctl enable mysql
log "Services ทำงานปกติ"

# ── 12. ติดตั้ง Cloudflare Tunnel (cloudflared) ──────────────
info "ติดตั้ง cloudflared..."
ARCH=$(dpkg --print-architecture)
CF_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}.deb"

if wget -q "$CF_URL" -O /tmp/cloudflared.deb; then
  dpkg -i /tmp/cloudflared.deb
  rm /tmp/cloudflared.deb
  log "ติดตั้ง cloudflared สำเร็จ"
else
  warn "ดาวน์โหลด cloudflared ไม่สำเร็จ — ติดตั้งด้วยตนเองภายหลัง"
fi

# ── 13. สร้างไฟล์สรุปข้อมูล ──────────────────────────────────
SUMMARY_FILE="/root/setup-summary.txt"
cat > "$SUMMARY_FILE" <<SUMMARY
========================================
  LAMP Stack Setup Summary
  $(date)
========================================

MySQL root password : ${DB_ROOT_PASS}
phpMyAdmin password : ${PMA_PASS}

Web Root            : ${WEB_ROOT}
phpMyAdmin URL      : http://localhost/phpmyadmin

PHP Version         : $(php -v | head -1)
Apache Config       : ${APACHE_CONF}

Cloudflare Tunnel:
  รันคำสั่ง: cloudflared tunnel login
  แล้วสร้าง tunnel: cloudflared tunnel create my-site
  Route: cloudflared tunnel route dns my-site yourdomain.com
  รัน: cloudflared tunnel run my-site

CodeIgniter 3:
  วาง project ใน: ${WEB_ROOT}/
  .htaccess สร้างไว้แล้ว (ลบ index.php จาก URL)

========================================
SUMMARY

chmod 600 "$SUMMARY_FILE"

# ── สรุปผล ───────────────────────────────────────────────────
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║           ติดตั้งสำเร็จทั้งหมด! 🎉              ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "  MySQL root password : ${YELLOW}${DB_ROOT_PASS}${NC}"
echo -e "  phpMyAdmin URL      : ${CYAN}http://SERVER_IP/phpmyadmin${NC}"
echo -e "  PHP Version         : $(php -v | head -1 | awk '{print $1,$2}')"
echo ""
echo -e "  รายละเอียดทั้งหมดบันทึกไว้ที่: ${YELLOW}${SUMMARY_FILE}${NC}"
echo ""
echo -e "  ${CYAN}ขั้นตอนต่อไป (Cloudflare Tunnel):${NC}"
echo -e "  1. cloudflared tunnel login"
echo -e "  2. cloudflared tunnel create my-site"
echo -e "  3. cloudflared tunnel route dns my-site yourdomain.com"
echo -e "  4. cloudflared tunnel run my-site"
echo ""
