#!/data/data/com.termux/files/usr/bin/bash
# =====================================================
# Frida Auto Setup Script for Termux (Updated 2026)
# รองรับ Frida 17.x + Auto detect + ติดตั้งครบ
#
# วิธีใช้: chmod 755 setup.sh && ./setup.sh
# =====================================================

clear

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

print_banner() {
    echo -e "${CYAN}"
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║       ⚡ Frida Auto Setup for Termux v3.0 ⚡             ║"
    echo "║       Auto detect · Install · Configure                  ║"
    echo "║       Supports Frida 17.x (Java bridge separated)       ║"
    echo "╚═══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_step() {
    echo -e "${BLUE}[Step $1/$2]${NC} ${BOLD}$3${NC}"
}

print_ok() {
    echo -e "${GREEN}[✓]${NC} $1"
}

print_warn() {
    echo -e "${YELLOW}[!]${NC} $1"
}

print_err() {
    echo -e "${RED}[✗]${NC} $1"
}

print_banner

# ==================== Device Info ====================
print_step 1 8 "Detecting device info..."
echo ""

DEVICE_MODEL=$(getprop ro.product.model 2>/dev/null || echo "Unknown")
DEVICE_BRAND=$(getprop ro.product.brand 2>/dev/null || echo "Unknown")
ANDROID_VER=$(getprop ro.build.version.release 2>/dev/null || echo "Unknown")
SDK_VER=$(getprop ro.build.version.sdk 2>/dev/null || echo "Unknown")
CPU_ABI=$(getprop ro.product.cpu.abi 2>/dev/null || uname -m)
CPU_ABI_LIST=$(getprop ro.product.cpu.abilist 2>/dev/null || echo "Unknown")
KERNEL_VER=$(uname -r 2>/dev/null || echo "Unknown")

echo "┌─────────────────────────────────────────────────────┐"
echo "│  Device Information                                  │"
echo "├─────────────────────────────────────────────────────┤"
printf "│ %-12s: %-40s│\n" "Brand" "$DEVICE_BRAND"
printf "│ %-12s: %-40s│\n" "Model" "$DEVICE_MODEL"
printf "│ %-12s: %-40s│\n" "Android" "$ANDROID_VER (SDK $SDK_VER)"
printf "│ %-12s: %-40s│\n" "CPU ABI" "$CPU_ABI"
printf "│ %-12s: %-40s│\n" "Kernel" "$KERNEL_VER"
echo "└─────────────────────────────────────────────────────┘"
echo ""

# Detect architecture
case "$CPU_ABI" in
    "arm64-v8a"|"aarch64")
        FRIDA_ARCH="arm64"
        DEVKIT_ARCH="arm64"
        ARCH_BITS="64-bit"
        ;;
    "armeabi-v7a"|"armv7l")
        FRIDA_ARCH="arm"
        DEVKIT_ARCH="arm"
        ARCH_BITS="32-bit"
        ;;
    "x86_64")
        FRIDA_ARCH="x86_64"
        DEVKIT_ARCH="x86_64"
        ARCH_BITS="64-bit"
        ;;
    "x86")
        FRIDA_ARCH="x86"
        DEVKIT_ARCH="x86"
        ARCH_BITS="32-bit"
        ;;
    *)
        print_err "Unknown architecture: $CPU_ABI"
        exit 1
        ;;
esac

print_ok "Architecture: $ARCH_BITS ($FRIDA_ARCH)"
echo ""

# ==================== Check existing Frida ====================
print_step 2 8 "Checking existing Frida installation..."

EXISTING_FRIDA=""
if command -v frida &> /dev/null; then
    EXISTING_FRIDA=$(frida --version 2>/dev/null || echo "unknown")
    print_warn "Found existing Frida client: $EXISTING_FRIDA"
else
    echo "  No existing Frida client found."
fi

EXISTING_SERVER=""
for ROOT_TEST in "tsu -c" "su -c"; do
    SERVER_VER=$($ROOT_TEST '/data/local/tmp/frida-server --version' 2>/dev/null)
    if [ -n "$SERVER_VER" ]; then
        EXISTING_SERVER="$SERVER_VER"
        break
    fi
done
if [ -n "$EXISTING_SERVER" ]; then
    print_warn "Found existing frida-server: $EXISTING_SERVER"
else
    echo "  No existing frida-server found."
fi
echo ""

# ==================== Fetch Latest Version ====================
print_step 3 8 "Fetching latest Frida version from GitHub..."

FRIDA_VER=""

# ลอง fetch จาก GitHub API
if command -v curl &> /dev/null; then
    FRIDA_VER=$(curl -s --connect-timeout 10 "https://api.github.com/repos/frida/frida/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
fi

# ถ้า fetch ไม่ได้ ใช้ hardcoded version
if [ -z "$FRIDA_VER" ]; then
    FRIDA_VER="17.6.2"
    print_warn "Cannot fetch from GitHub, using fallback: $FRIDA_VER"
else
    print_ok "Latest version: $FRIDA_VER"
fi

# ให้เลือกเวอร์ชัน
echo ""
echo -e "${YELLOW}  Current: ${EXISTING_FRIDA:-none} -> New: $FRIDA_VER${NC}"
echo ""
echo -e "  Press ${BOLD}Enter${NC} to use $FRIDA_VER, or type version (e.g. 17.5.1):"
read -r CUSTOM_VER

if [ -n "$CUSTOM_VER" ]; then
    FRIDA_VER="$CUSTOM_VER"
    print_ok "Using custom version: $FRIDA_VER"
fi
echo ""

# ==================== Update Termux ====================
print_step 4 8 "Updating Termux packages..."
pkg update -y 2>&1 | tail -1
pkg upgrade -y 2>&1 | tail -1
print_ok "Termux updated!"
echo ""

# ==================== Install Dependencies ====================
print_step 5 8 "Installing dependencies..."
pkg install -y python python-pip git wget curl xz-utils tsu build-essential binutils openssl 2>&1 | tail -3
pip install -q --upgrade setuptools wheel 2>/dev/null
print_ok "Dependencies installed!"
echo ""

# ==================== Storage ====================
if [ ! -d ~/storage ]; then
    echo "[*] Setting up storage access..."
    termux-setup-storage
    sleep 2
fi

# ==================== Install Frida Client ====================
print_step 6 8 "Installing Frida client (frida-tools)..."
echo ""

# ===== วิธีที่ 1: pkg install (ง่ายสุด, อาจไม่ใช่ล่าสุด) =====
# ===== วิธีที่ 2: devkit build (ได้เวอร์ชันล่าสุด) =====

echo -e "  ${BOLD}เลือกวิธีติดตั้ง:${NC}"
echo -e "  ${GREEN}1)${NC} pkg install frida-tools (ง่าย, เวอร์ชันอาจไม่ตรง)"
echo -e "  ${GREEN}2)${NC} Build จาก devkit (ได้เวอร์ชัน $FRIDA_VER ตรงๆ) ${YELLOW}[แนะนำ]${NC}"
echo ""
echo -n "  เลือก [1/2] (default: 2): "
read -r INSTALL_METHOD

if [ "$INSTALL_METHOD" = "1" ]; then
    # ===== วิธี pkg =====
    echo ""
    echo "[*] Installing via pkg..."
    pkg install -y frida-tools 2>&1

    INSTALLED_VER=$(frida --version 2>/dev/null)
    if [ -n "$INSTALLED_VER" ]; then
        print_ok "Frida client installed: $INSTALLED_VER"
        # อัปเดต FRIDA_VER ให้ตรงกับที่ได้
        FRIDA_VER="$INSTALLED_VER"
    else
        print_err "pkg install failed, falling back to devkit method..."
        INSTALL_METHOD="2"
    fi
fi

if [ "$INSTALL_METHOD" != "1" ]; then
    # ===== วิธี devkit build =====
    echo ""
    echo "[*] Building Frida $FRIDA_VER from devkit..."

    cd "$HOME"

    # Download devkit
    DEVKIT_URL="https://github.com/frida/frida/releases/download/${FRIDA_VER}/frida-core-devkit-${FRIDA_VER}-android-${DEVKIT_ARCH}.tar.xz"
    echo "[*] Downloading devkit: $DEVKIT_URL"

    rm -f frida-core-devkit.tar.xz 2>/dev/null
    curl -L -o frida-core-devkit.tar.xz "$DEVKIT_URL" --progress-bar

    if [ ! -f frida-core-devkit.tar.xz ]; then
        print_err "Devkit download failed!"
        exit 1
    fi

    # Extract devkit
    rm -rf "$HOME/devkit" 2>/dev/null
    mkdir -p "$HOME/devkit"
    tar -xvf frida-core-devkit.tar.xz -C "$HOME/devkit" 2>&1 | tail -3
    rm -f frida-core-devkit.tar.xz

    # Clone frida-python (patched for Termux)
    rm -rf "$HOME/frida-python-android" 2>/dev/null
    echo "[*] Cloning frida-python (patched for Termux/Android)..."
    git clone --depth 1 https://github.com/AbhiTheModder/frida-python "$HOME/frida-python-android" 2>&1 | tail -2

    # Build & install
    cd "$HOME/frida-python-android"
    echo "[*] Building frida Python module... (อาจใช้เวลา 1-3 นาที)"
    FRIDA_VERSION="$FRIDA_VER" FRIDA_CORE_DEVKIT="$HOME/devkit" pip install --force-reinstall . 2>&1 | tail -5

    # Cleanup
    cd "$HOME"
    rm -rf "$HOME/frida-python-android" "$HOME/devkit" 2>/dev/null

    # Install frida-tools
    echo "[*] Installing frida-tools..."
    pip install --upgrade "frida-tools>14.0.2" 2>&1 | tail -3

    INSTALLED_VER=$(frida --version 2>/dev/null)
    if [ -n "$INSTALLED_VER" ]; then
        print_ok "Frida client installed: $INSTALLED_VER"
    else
        print_err "Frida client installation failed!"
        echo ""
        echo -e "${YELLOW}ลอง fallback: pkg install -y frida-tools${NC}"
        exit 1
    fi
fi
echo ""

# ==================== Download Frida Server ====================
print_step 7 8 "Downloading frida-server $FRIDA_VER for $FRIDA_ARCH..."

FRIDA_SERVER_NAME="frida-server-${FRIDA_VER}-android-${FRIDA_ARCH}"
SERVER_URL="https://github.com/frida/frida/releases/download/${FRIDA_VER}/${FRIDA_SERVER_NAME}.xz"

echo "[*] URL: $SERVER_URL"

cd "$HOME"
rm -f frida-server.xz frida-server 2>/dev/null

curl -L -o frida-server.xz "$SERVER_URL" --progress-bar

if [ ! -f frida-server.xz ]; then
    print_err "frida-server download failed!"
    exit 1
fi

# Extract
echo "[*] Extracting..."
xz -d -f frida-server.xz

if [ ! -f frida-server ]; then
    print_err "Extract failed!"
    exit 1
fi

print_ok "frida-server downloaded!"
echo ""

# ==================== Install Frida Server (root) ====================
print_step 8 8 "Installing frida-server to /data/local/tmp/..."
echo ""

# Detect root method
ROOT_CMD=""

for CMD in "tsu -c" "su -c"; do
    if $CMD 'id' 2>/dev/null | grep -q "uid=0"; then
        ROOT_CMD="$CMD"
        print_ok "Root access: $CMD"
        break
    fi
done

if [ -z "$ROOT_CMD" ]; then
    # Try su without -c
    if echo "id" | su 2>/dev/null | grep -q "uid=0"; then
        ROOT_CMD="su -c"
        print_ok "Root access: su"
    fi
fi

if [ -z "$ROOT_CMD" ]; then
    print_warn "Root not detected!"
    echo ""
    echo -e "  ${YELLOW}วิธีติดตั้ง frida-server แบบ manual:${NC}"
    echo ""
    echo "  1. เปิด Magisk > Superuser > ให้สิทธิ์ Termux"
    echo "  2. รีสตาร์ท Termux แล้วรัน:"
    echo ""
    echo "     su"
    echo "     pkill -9 frida-server"
    echo "     cp ~/frida-server /data/local/tmp/"
    echo "     chmod 755 /data/local/tmp/frida-server"
    echo "     setenforce 0"
    echo "     /data/local/tmp/frida-server -D"
    echo ""
else
    # Kill existing server
    $ROOT_CMD 'pkill -9 frida-server' 2>/dev/null
    sleep 1

    # Copy to /data/local/tmp/
    $ROOT_CMD "cp $HOME/frida-server /data/local/tmp/frida-server"
    $ROOT_CMD 'chmod 755 /data/local/tmp/frida-server'

    # Verify
    SERVER_VER=$($ROOT_CMD '/data/local/tmp/frida-server --version' 2>/dev/null)

    if [ -n "$SERVER_VER" ]; then
        print_ok "frida-server installed: $SERVER_VER"
    else
        print_warn "Cannot verify, but files copied. Try starting manually."
    fi

    # Version match check
    CLIENT_VER=$(frida --version 2>/dev/null)
    if [ -n "$CLIENT_VER" ] && [ -n "$SERVER_VER" ]; then
        if [ "$CLIENT_VER" = "$SERVER_VER" ]; then
            print_ok "Version match! client=$CLIENT_VER server=$SERVER_VER"
        else
            print_warn "Version MISMATCH! client=$CLIENT_VER server=$SERVER_VER"
            echo -e "  ${YELLOW}เวอร์ชันไม่ตรงกัน อาจทำให้เกิด error ได้!${NC}"
        fi
    fi
fi
echo ""

# ==================== Create Helper Scripts ====================
echo "[*] Creating helper scripts..."

# ---------- start_frida.sh ----------
cat > ~/start_frida.sh << 'STARTEOF'
#!/data/data/com.termux/files/usr/bin/bash
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

echo "[*] Starting frida-server..."

# Detect root
ROOT_CMD=""
for CMD in "tsu -c" "su -c"; do
    if $CMD 'id' 2>/dev/null | grep -q "uid=0"; then
        ROOT_CMD="$CMD"
        break
    fi
done

if [ -z "$ROOT_CMD" ]; then
    echo -e "${RED}[!] Root not available. Grant Termux root in Magisk.${NC}"
    exit 1
fi

# Kill existing
$ROOT_CMD 'pkill -9 frida-server' 2>/dev/null
sleep 1

# Disable SELinux
$ROOT_CMD 'setenforce 0' 2>/dev/null

# Check if frida-server exists
if ! $ROOT_CMD 'test -f /data/local/tmp/frida-server' 2>/dev/null; then
    echo -e "${RED}[!] frida-server not found at /data/local/tmp/${NC}"
    echo "    Run setup.sh first!"
    exit 1
fi

# Start (listen on all interfaces)
echo "[*] Starting on 0.0.0.0:27042..."
$ROOT_CMD '/data/local/tmp/frida-server -l 0.0.0.0:27042 -D' 2>/dev/null
sleep 2

# Verify
SERVER_PID=$($ROOT_CMD 'pidof frida-server' 2>/dev/null)
if [ -n "$SERVER_PID" ]; then
    SERVER_VER=$($ROOT_CMD '/data/local/tmp/frida-server --version' 2>/dev/null)
    echo -e "${GREEN}[+] frida-server running! (PID: $SERVER_PID, Version: $SERVER_VER)${NC}"
    echo ""

    # Quick connectivity test
    if command -v frida-ps &> /dev/null; then
        echo "[*] Testing connection..."
        if frida-ps -H 127.0.0.1:27042 2>/dev/null | head -5; then
            echo -e "${GREEN}[+] Connection OK!${NC}"
        else
            # Fallback: try USB mode
            if frida-ps -U 2>/dev/null | head -5; then
                echo -e "${GREEN}[+] Connection OK (USB mode)!${NC}"
            else
                echo -e "${YELLOW}[!] Server running but connection test failed.${NC}"
                echo "    Try: frida-ps -U  or  frida-ps -H 127.0.0.1:27042"
            fi
        fi
    fi
else
    echo -e "${RED}[!] Failed to start frida-server${NC}"
    echo ""
    echo "Troubleshooting:"
    echo "  1. Check Magisk Superuser permission for Termux"
    echo "  2. Try manual start:"
    echo "     su"
    echo "     setenforce 0"
    echo "     /data/local/tmp/frida-server -l 0.0.0.0:27042 &"
fi
STARTEOF
chmod 755 ~/start_frida.sh

# ---------- stop_frida.sh ----------
cat > ~/stop_frida.sh << 'STOPEOF'
#!/data/data/com.termux/files/usr/bin/bash
echo "[*] Stopping frida-server..."
for CMD in "tsu -c" "su -c"; do
    $CMD 'pkill -9 frida-server' 2>/dev/null && echo "[+] Stopped!" && exit 0
done
echo "[!] Could not stop (no root or not running)"
STOPEOF
chmod 755 ~/stop_frida.sh

# ---------- hook.sh ----------
cat > ~/hook.sh << 'HOOKEOF'
#!/data/data/com.termux/files/usr/bin/bash
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

if [ -z "$1" ]; then
    echo -e "${CYAN}Frida Hook Helper${NC}"
    echo ""
    echo "Usage: ./hook.sh <package_name> [script.js] [options]"
    echo ""
    echo "Examples:"
    echo -e "  ${GREEN}./hook.sh com.example.app${NC}                    # Spawn & attach (REPL)"
    echo -e "  ${GREEN}./hook.sh com.example.app myscript.js${NC}        # Spawn with script"
    echo -e "  ${GREEN}./hook.sh com.example.app myscript.js --no-pause${NC}"
    echo ""
    echo "List running apps:"
    echo -e "  ${GREEN}frida-ps -H 127.0.0.1:27042 -ai${NC}             # All installed apps"
    echo -e "  ${GREEN}frida-ps -U -ai${NC}                              # USB mode"
    echo ""
    exit 1
fi

PKG="$1"
SCRIPT="$2"
shift 2 2>/dev/null
EXTRA_ARGS="$@"

# Auto-detect connection mode
CONN=""
if frida-ps -H 127.0.0.1:27042 &>/dev/null 2>&1; then
    CONN="-H 127.0.0.1:27042"
elif frida-ps -U &>/dev/null 2>&1; then
    CONN="-U"
else
    echo -e "${YELLOW}[!] No frida-server detected. Run ~/start_frida.sh first${NC}"
    exit 1
fi

echo "[*] Connection: $CONN"
echo "[*] Target: $PKG"

if [ -n "$SCRIPT" ]; then
    if [ ! -f "$SCRIPT" ]; then
        echo -e "${YELLOW}[!] Script not found: $SCRIPT${NC}"
        exit 1
    fi
    echo "[*] Script: $SCRIPT"
    echo ""
    frida $CONN -f "$PKG" -l "$SCRIPT" $EXTRA_ARGS
else
    echo "[*] Mode: REPL (no script)"
    echo ""
    frida $CONN -f "$PKG" $EXTRA_ARGS
fi
HOOKEOF
chmod 755 ~/hook.sh

# ---------- frida-status.sh ----------
cat > ~/frida-status.sh << 'STATUSEOF'
#!/data/data/com.termux/files/usr/bin/bash
GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

echo -e "${CYAN}=== Frida Status ===${NC}"
echo ""

# Client version
if command -v frida &> /dev/null; then
    CLIENT_VER=$(frida --version 2>/dev/null)
    echo -e "  Client  : ${GREEN}$CLIENT_VER${NC}"
else
    echo -e "  Client  : ${RED}Not installed${NC}"
fi

# Server version
SERVER_VER=""
for CMD in "tsu -c" "su -c"; do
    SERVER_VER=$($CMD '/data/local/tmp/frida-server --version' 2>/dev/null)
    if [ -n "$SERVER_VER" ]; then break; fi
done
if [ -n "$SERVER_VER" ]; then
    echo -e "  Server  : ${GREEN}$SERVER_VER${NC}"
else
    echo -e "  Server  : ${RED}Not found${NC}"
fi

# Version match
if [ -n "$CLIENT_VER" ] && [ -n "$SERVER_VER" ]; then
    if [ "$CLIENT_VER" = "$SERVER_VER" ]; then
        echo -e "  Match   : ${GREEN}OK${NC}"
    else
        echo -e "  Match   : ${RED}MISMATCH!${NC} (client=$CLIENT_VER server=$SERVER_VER)"
    fi
fi

# Server running?
SERVER_PID=""
for CMD in "tsu -c" "su -c"; do
    SERVER_PID=$($CMD 'pidof frida-server' 2>/dev/null)
    if [ -n "$SERVER_PID" ]; then break; fi
done
if [ -n "$SERVER_PID" ]; then
    echo -e "  Running : ${GREEN}Yes (PID: $SERVER_PID)${NC}"
else
    echo -e "  Running : ${YELLOW}No${NC}"
fi

# Connection test
echo ""
echo -e "${CYAN}=== Connection Test ===${NC}"
echo ""
if frida-ps -H 127.0.0.1:27042 &>/dev/null 2>&1; then
    PROC_COUNT=$(frida-ps -H 127.0.0.1:27042 2>/dev/null | wc -l)
    echo -e "  Network : ${GREEN}OK${NC} ($PROC_COUNT processes)"
else
    echo -e "  Network : ${RED}FAIL${NC} (127.0.0.1:27042)"
fi
if frida-ps -U &>/dev/null 2>&1; then
    echo -e "  USB     : ${GREEN}OK${NC}"
else
    echo -e "  USB     : ${YELLOW}N/A${NC}"
fi

# SELinux
SELINUX=""
for CMD in "tsu -c" "su -c"; do
    SELINUX=$($CMD 'getenforce' 2>/dev/null)
    if [ -n "$SELINUX" ]; then break; fi
done
if [ -n "$SELINUX" ]; then
    if [ "$SELINUX" = "Permissive" ]; then
        echo -e "  SELinux : ${GREEN}$SELINUX${NC}"
    else
        echo -e "  SELinux : ${YELLOW}$SELINUX${NC} (ควรเป็น Permissive)"
    fi
fi

echo ""
STATUSEOF
chmod 755 ~/frida-status.sh

# ---------- Example: crypto_hook.js ----------
cat > ~/crypto_hook.js << 'CRYPTOEOF'
/*
 * Frida 17.x Crypto Hook Example
 * ใช้กับ: frida -H 127.0.0.1:27042 -f <package> -l crypto_hook.js
 *
 * Note: Frida 17.x - Java bridge ถูกโหลดอัตโนมัติโดย frida-tools
 */

Java.perform(function() {
    console.log("[*] Java bridge loaded successfully!");
    console.log("[*] Hooking crypto operations...");

    // ===== javax.crypto.Cipher =====
    try {
        var Cipher = Java.use("javax.crypto.Cipher");

        Cipher.getInstance.overload("java.lang.String").implementation = function(algo) {
            console.log("[Cipher.getInstance] Algorithm: " + algo);
            return this.getInstance(algo);
        };

        Cipher.doFinal.overload("[B").implementation = function(input) {
            console.log("[Cipher.doFinal] Input length: " + input.length);
            var result = this.doFinal(input);
            console.log("[Cipher.doFinal] Output length: " + result.length);
            return result;
        };

        console.log("[+] Cipher hooked!");
    } catch(e) {
        console.log("[-] Cipher hook failed: " + e);
    }

    // ===== java.security.MessageDigest =====
    try {
        var MessageDigest = Java.use("java.security.MessageDigest");

        MessageDigest.getInstance.overload("java.lang.String").implementation = function(algo) {
            console.log("[MessageDigest] Algorithm: " + algo);
            return this.getInstance(algo);
        };

        console.log("[+] MessageDigest hooked!");
    } catch(e) {
        console.log("[-] MessageDigest hook failed: " + e);
    }

    // ===== SSL Pinning Bypass (basic) =====
    try {
        var TrustManagerImpl = Java.use("com.android.org.conscrypt.TrustManagerImpl");
        TrustManagerImpl.verifyChain.implementation = function() {
            console.log("[SSL] Bypassed certificate verification");
            return arguments[0];
        };
        console.log("[+] SSL pin bypass hooked!");
    } catch(e) {
        console.log("[-] SSL bypass not applicable: " + e.message);
    }

    console.log("[*] All hooks ready! App is running...");
});
CRYPTOEOF

# ---------- Example: anti_detection.js ----------
cat > ~/anti_detection.js << 'ANTIEOF'
/*
 * Frida 17.x Anti Root/Frida Detection Bypass
 * ใช้กับ: ~/hook.sh <package> anti_detection.js
 */

Java.perform(function() {
    console.log("[*] Loading anti-detection bypasses...");

    // ===== Root Detection Bypass =====
    try {
        var RootBeer = Java.use("com.scottyab.rootbeer.RootBeer");
        RootBeer.isRooted.implementation = function() {
            console.log("[RootBeer] isRooted() -> false");
            return false;
        };
        console.log("[+] RootBeer bypassed!");
    } catch(e) {}

    // ===== File.exists bypass for root paths =====
    try {
