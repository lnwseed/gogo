#!/data/data/com.termux/files/usr/bin/bash
# ============================================
# Frida Gadget Installer for Termux
# ============================================

set -e

FRIDA_VERSION="16.6.6"
INSTALL_DIR="/data/local/tmp"
GADGET_DIR="$HOME/frida-gadget"

# สี
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[-]${NC} $1"; exit 1; }
info() { echo -e "${BLUE}[*]${NC} $1"; }

# ==================== เช็ค root ====================
check_root() {
    info "Checking root access..."
    if ! su -c "id" &>/dev/null; then
        err "Root access required!"
    fi
    log "Root access OK"
}

# ==================== ติดตั้ง dependencies ====================
install_deps() {
    info "Installing dependencies..."
    pkg update -y -q
    pkg install -y -q \
        python \
        python-pip \
        wget \
        curl \
        tar \
        xz-utils \
        openjdk-17 \
        apktool \
        aapt \
        zip \
        unzip
    log "Dependencies installed"
}

# ==================== ติดตั้ง frida ====================
install_frida() {
    info "Installing frida $FRIDA_VERSION..."
    pip install -q \
        frida==$FRIDA_VERSION \
        frida-tools \
        objection
    
    INSTALLED=$(frida --version)
    log "Frida installed: $INSTALLED"
}

# ==================== เช็ค arch ====================
get_arch() {
    ARCH=$(getprop ro.product.cpu.abi)
    info "Device arch: $ARCH"
    
    case $ARCH in
        arm64-v8a)   GADGET_ARCH="arm64" ;;
        armeabi-v7a) GADGET_ARCH="arm"   ;;
        x86_64)      GADGET_ARCH="x86_64";;
        x86)         GADGET_ARCH="x86"   ;;
        *)           err "Unsupported arch: $ARCH" ;;
    esac
    
    log "Gadget arch: $GADGET_ARCH"
}

# ==================== ดาวน์โหลด Gadget ====================
download_gadget() {
    mkdir -p "$GADGET_DIR"
    
    GADGET_FILE="frida-gadget-${FRIDA_VERSION}-android-${GADGET_ARCH}.so.xz"
    GADGET_URL="https://github.com/frida/frida/releases/download/${FRIDA_VERSION}/${GADGET_FILE}"
    GADGET_SO="$GADGET_DIR/libfrida-gadget.so"

    info "Downloading Frida Gadget $FRIDA_VERSION..."
    
    if [ -f "$GADGET_SO" ]; then
        warn "Gadget already exists, skipping download"
    else
        wget -q --show-progress -O "$GADGET_DIR/$GADGET_FILE" "$GADGET_URL" \
            || err "Download failed! Check internet connection"
        
        info "Extracting..."
        xz -d "$GADGET_DIR/$GADGET_FILE"
        
        # rename ให้ตรง
        mv "$GADGET_DIR/frida-gadget-${FRIDA_VERSION}-android-${GADGET_ARCH}.so" \
           "$GADGET_SO"
        
        log "Gadget downloaded: $GADGET_SO"
    fi
}

# ==================== สร้าง Gadget Config ====================
create_config() {
    CONFIG_FILE="$GADGET_DIR/libfrida-gadget.config.so"
    
    info "Creating gadget config..."
    cat > "$CONFIG_FILE" << 'EOF'
{
  "interaction": {
    "type": "listen",
    "address": "127.0.0.1",
    "port": 27042,
    "on_port_conflict": "fail",
    "on_load": "wait"
  }
}
EOF
    log "Config created: $CONFIG_FILE"
}

# ==================== Patch APK ====================
patch_apk() {
    if [ -z "$1" ]; then
        warn "No APK specified"
        info "Usage: patch_apk <path_to_apk>"
        return
    fi

    APK_PATH="$1"
    APK_NAME=$(basename "$APK_PATH" .apk)
    WORK_DIR="$GADGET_DIR/work_${APK_NAME}"
    OUTPUT_APK="$GADGET_DIR/${APK_NAME}_patched.apk"

    info "Patching: $APK_PATH"

    # 1. Decompile
    info "Decompiling APK..."
    apktool d -f "$APK_PATH" -o "$WORK_DIR" \
        || err "Decompile failed"

    # 2. Copy gadget .so
    info "Injecting gadget..."
    for ABI in arm64-v8a armeabi-v7a x86_64 x86; do
        LIB_DIR="$WORK_DIR/lib/$ABI"
        if [ -d "$LIB_DIR" ]; then
            cp "$GADGET_DIR/libfrida-gadget.so" "$LIB_DIR/"
            cp "$GADGET_DIR/libfrida-gadget.config.so" "$LIB_DIR/"
            log "Copied gadget to $ABI"
        fi
    done

    # ถ้าไม่มี lib folder เลย สร้างใหม่
    LIB_TARGET="$WORK_DIR/lib/$GADGET_ARCH"
    if [ ! -d "$LIB_TARGET" ]; then
        mkdir -p "$LIB_TARGET"
        cp "$GADGET_DIR/libfrida-gadget.so" "$LIB_TARGET/"
        cp "$GADGET_DIR/libfrida-gadget.config.so" "$LIB_TARGET/"
        log "Created lib/$GADGET_ARCH and copied gadget"
    fi

    # 3. Inject loadLibrary ใน smali
    info "Injecting loadLibrary into smali..."
    inject_smali "$WORK_DIR"

    # 4. Recompile
    info "Recompiling APK..."
    apktool b "$WORK_DIR" -o "$OUTPUT_APK" \
        || err "Recompile failed"

    # 5. Sign APK
    sign_apk "$OUTPUT_APK"

    log "✅ Patched APK: $OUTPUT_APK"
    info "Install with: adb install $OUTPUT_APK"
}

# ==================== Inject smali ====================
inject_smali() {
    WORK_DIR="$1"
    
    # หา MainActivity
    MAIN_SMALI=$(find "$WORK_DIR/smali" -name "MainActivity.smali" | head -1)
    
    if [ -z "$MAIN_SMALI" ]; then
        # ลองหาจาก AndroidManifest
        MAIN_CLASS=$(grep -o 'android:name="[^"]*Activity[^"]*"' \
            "$WORK_DIR/AndroidManifest.xml" | head -1 | \
            sed 's/android:name="//;s/"//' | \
            sed 's/\./\//g')
        MAIN_SMALI=$(find "$WORK_DIR/smali" -path "*${MAIN_CLASS}*.smali" | head -1)
    fi

    if [ -z "$MAIN_SMALI" ]; then
        warn "MainActivity.smali not found, skipping smali injection"
        warn "You may need to add loadLibrary manually"
        return
    fi

    info "Found smali: $MAIN_SMALI"

    # เช็คว่า inject ไปแล้วหรือยัง
    if grep -q "frida-gadget" "$MAIN_SMALI"; then
        warn "Already injected, skipping"
        return
    fi

    # Inject หลัง .method protected onCreate
    INJECT_CODE='\n    const-string v0, "frida-gadget"\n    invoke-static {v0}, Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V\n'
    
    sed -i "/\.method protected onCreate/a\\$INJECT_CODE" "$MAIN_SMALI"
    
    log "Smali injected: $MAIN_SMALI"
}

# ==================== Sign APK ====================
sign_apk() {
    APK="$1"
    KEYSTORE="$GADGET_DIR/debug.keystore"

    # สร้าง keystore ถ้ายังไม่มี
    if [ ! -f "$KEYSTORE" ]; then
        info "Creating debug keystore..."
        keytool -genkey -v \
            -keystore "$KEYSTORE" \
            -alias androiddebugkey \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -storepass android \
            -keypass android \
            -dname "CN=Android Debug,O=Android,C=US" \
            &>/dev/null
        log "Keystore created"
    fi

    info "Signing APK..."
    jarsigner -verbose \
        -sigalg SHA1withRSA \
        -digestalg SHA1 \
        -keystore "$KEYSTORE" \
        -storepass android \
        -keypass android \
        "$APK" androiddebugkey \
        &>/dev/null
    
    log "APK signed"
}

# ==================== ติดตั้ง frida-server ด้วย (optional) ====================
install_frida_server() {
    SERVER_FILE="frida-server-${FRIDA_VERSION}-android-${GADGET_ARCH}.xz"
    SERVER_URL="https://github.com/frida/frida/releases/download/${FRIDA_VERSION}/${SERVER_FILE}"
    SERVER_PATH="$INSTALL_DIR/frida-server"

    info "Downloading frida-server $FRIDA_VERSION..."
    wget -q --show-progress -O "$INSTALL_DIR/$SERVER_FILE" "$SERVER_URL" \
        || err "Download failed"

    xz -d "$INSTALL_DIR/$SERVER_FILE"
    mv "$INSTALL_DIR/frida-server-${FRIDA_VERSION}-android-${GADGET_ARCH}" "$SERVER_PATH"
    su -c "chmod 755 $SERVER_PATH"

    log "frida-server installed: $SERVER_PATH"
}

# ==================== สร้าง hook script ตัวอย่าง ====================
create_hook_script() {
    HOOK_FILE="$GADGET_DIR/hook.py"
    cat > "$HOOK_FILE" << 'PYEOF'
import frida
import sys

JS_HOOK = """
Java.perform(function() {
    console.log("[*] Gadget connected!");

    // File.exists bypass
    var File = Java.use("java.io.File");
    var ROOT_PATHS = [
        "/system/xbin/su", "/system/bin/su", "/sbin/su",
        "/data/local/su", "/magisk", "/.magisk", "/data/adb/magisk"
    ];
    File.exists.implementation = function() {
        var path = this.getAbsolutePath();
        for (var i = 0; i < ROOT_PATHS.length; i++) {
            if (path.indexOf(ROOT_PATHS[i]) !== -1) {
                console.log("[Bypass] File.exists blocked: " + path);
                return false;
            }
        }
        return this.exists();
    };

    // isDebuggerConnected bypass
    var Debug = Java.use("android.os.Debug");
    Debug.isDebuggerConnected.implementation = function() {
        return false;
    };

    // Build.TAGS bypass
    var Build = Java.use("android.os.Build");
    Build.TAGS.value = "release-keys";

    console.log("[*] All hooks applied!");
});
"""

def on_message(message, data):
    if message["type"] == "send":
        print("[JS]", message["payload"])
    elif message["type"] == "error":
        print("[ERR]", message["stack"])

print("[*] Connecting to Gadget...")
device  = frida.get_remote_device()
session = device.attach("Gadget")
script  = session.create_script(JS_HOOK)
script.on("message", on_message)
script.load()
print("[*] Hooks running! Ctrl+C to stop")
sys.stdin.read()
PYEOF
    log "Hook script created: $HOOK_FILE"
}

# ==================== MAIN ====================
main() {
    echo ""
    echo -e "${BLUE}╔══════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║     Frida Gadget Installer v1.0      ║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════╝${NC}"
    echo ""

    check_root
    install_deps
    install_frida
    get_arch
    download_gadget
    create_config
    create_hook_script
    install_frida_server

    echo ""
    echo -e "${GREEN}╔══════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║           ✅ Install Complete!        ║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}📁 Files location: $GADGET_DIR${NC}"
    echo ""
    echo -e "${BLUE}📌 วิธีใช้:${NC}"
    echo -e "  1. Patch APK:"
    echo -e "     ${GREEN}bash install_gadget.sh patch /path/to/app.apk${NC}"
    echo ""
    echo -e "  2. ติดตั้ง patched APK:"
    echo -e "     ${GREEN}adb install $GADGET_DIR/<app>_patched.apk${NC}"
    echo ""
    echo -e "  3. เปิดแอป (จะค้างรอ connection)"
    echo ""
    echo -e "  4. Forward port:"
    echo -e "     ${GREEN}adb forward tcp:27042 tcp:27042${NC}"
    echo ""
    echo -e "  5. รัน hook:"
    echo -e "     ${GREEN}python $GADGET_DIR/hook.py${NC}"
    echo ""
}

# ==================== รับ argument ====================
case "${1:-}" in
    patch)
        get_arch
        patch_apk "$2"
        ;;
    server)
        get_arch
        install_frida_server
        ;;
    *)
        main
        ;;
esac
